# https://editorconfig.org — shared editor settings for every platform and IDE.
# Files are UTF-8 (no BOM) with LF line endings; .gitattributes enforces the
# same line endings in git, and Prettier (`endOfLine: "lf"`) in formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk,*.go}]
indent_style = tab

[*.{bat,cmd}]
# Windows batch scripts keep CRLF (see .gitattributes).
end_of_line = crlf
