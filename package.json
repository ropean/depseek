{
  "name": "@ropean/depseek",
  "version": "0.0.1",
  "description": "Scan every package.json under a directory, find cross-project version conflicts and outdated deps, and update them in one go.",
  "keywords": [
    "dependencies",
    "package.json",
    "monorepo",
    "npm-check-updates",
    "ncu",
    "upgrade",
    "outdated",
    "version-conflicts",
    "bun",
    "pnpm",
    "cli"
  ],
  "homepage": "https://github.com/ropean/depseek#readme",
  "bugs": {
    "url": "https://github.com/ropean/depseek/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ropean/depseek.git"
  },
  "license": "MIT",
  "author": "ropean",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "depseek": "./dist/cli.mjs",
    "ds": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:exports": "publint --strict && attw --pack . --profile node16",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack:dry": "npm pack --dry-run",
    "link:global": "pnpm link --global",
    "unlink:global": "pnpm remove --global @ropean/depseek",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:beta": "node scripts/release.mjs prerelease --preid=beta",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.0.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.5",
    "@types/semver": "7.7.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "semver": "7.7.2"
  }
}
